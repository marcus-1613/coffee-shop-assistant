# ============ 咖啡店经营助手 · 环境变量模板 ============
# 使用方法：复制本文件为 .env，填入真实值
#   cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，切勿把真实 Key 提交到版本库

# --- DeepSeek 大模型（必填）---
# 在 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# DeepSeek API 地址（OpenAI 兼容接口，默认即可）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型
DEEPSEEK_MODEL=deepseek-chat

# --- JWT 认证密钥（必填，生产环境务必改成强随机值）---
# 用于签发/校验 JWT 令牌的签名密钥。
# 强烈建议用一段足够长的随机字符串，例如：
#   python -c "import secrets; print(secrets.token_hex(32))"
# 切勿使用默认值（dev-secret-key-change-in-production）上线。
SECRET_KEY=please-generate-a-random-secret-key
